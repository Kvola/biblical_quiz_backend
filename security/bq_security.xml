<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="privilege_quiz_biblique" model="res.groups.privilege">
            <field name="name">Quiz Biblique</field>
            <field name="category_id" ref="base.module_category_services"/>
            <field name="sequence">60</field>
        </record>
        <!-- Les joueurs ne sont PAS des utilisateurs internes : comptes portail,
             jeton porteur, routes en sudo filtrées par appartenance (controllers/).
             Ce groupe est celui de l'équipe qui suit le jeu en ligne. -->
        <record id="group_bq_manager" model="res.groups">
            <field name="name">Quiz Biblique — Gestionnaire du jeu en ligne</field>
            <field name="privilege_id" ref="privilege_quiz_biblique"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Joueurs, matchs, tournois, signalements de pseudos et réglages du jeu en ligne.</field>
        </record>
    </data>
</odoo>
